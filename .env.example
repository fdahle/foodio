SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Local timezone: decides "today" for tried dates and when the monthly challenge rolls over
TZ=Europe/Amsterdam

# Optional: only needed for `npm run sheet -- --api` / `--batch` (Gemini illustration sheets)
GEMINI_API_KEY=
# Optional: only needed for `npm --prefix api run images`
OPENAI_API_KEY=
